# Database
# Use the pooled connection URL for app/runtime queries when using Supabase.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Use the direct connection URL for Prisma generate/migrate/db push.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Public canonical site URL. Use your Vercel production URL in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# LLM providers
# Primary classifier model: Gemini 2.5 Flash-Lite.
GEMINI_API_KEY=""

# Fallback classifier and daily briefing model provider.
GROQ_API_KEY=""
